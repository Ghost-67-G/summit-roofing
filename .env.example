# Public URL the site is deployed to. Used for canonical links, Open Graph
# tags, JSON-LD and sitemap.xml. No trailing slash.
VITE_SITE_URL=https://www.summitroofingclt.com

# Where the inspection form POSTs its JSON payload — a Formspree form URL
# (https://formspree.io/f/xxxxxxx) or any webhook (Zapier, Make, n8n, ...).
# Leave empty to run the form in demo mode (validates, then shows success).
VITE_FORM_ENDPOINT=
