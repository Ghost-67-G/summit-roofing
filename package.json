{
  "name": "summit-roofing",
  "private": true,
  "version": "1.0.0",
  "description": "Demo website for a fictional Charlotte, NC roofing company. Vite + React, prerendered to static HTML.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.js",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "images": "node scripts/optimize-images.js",
    "og": "node scripts/render-og-image.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
